   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "x = np.linspace(0, 10, 100)\n",
    "y = np.sin(x)\n",
    "\n",
    "plt.plot(x, y)\n",
    "plt.title(\"Sine Wave\")  # Title add karna\n",
    "plt.xlabel(\"X-axis\")  # X-axis label\n",
    "plt.ylabel(\"Y-axis\")  # Y-axis label\n",
    "plt.show()\n"
   ]
